5)Create a webpage using JavaScript DOM manipulation and event 
handling with an image and a button. When the button is clicked, replace 
the displayed image with another image.
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Image Using JavaScript</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f2f2f2;
            padding: 40px;
        }

        img {
            width: 300px;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
            border: 3px solid #333;
            margin: 20px;
        }

        button {
            padding: 12px 25px;
            font-size: 16px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>

<body>

    <h1>Change Image</h1>

    <img id="myImage"
         src="https://picsum.photos/id/1015/300/200"
         alt="First Image">

    <br>

    <button id="changeBtn">Change Image</button>

    <script>
        // Get the image and button using DOM
        const image = document.getElementById("myImage");
        const button = document.getElementById("changeBtn");

        // Add click event to the button
        button.addEventListener("click", function() {

            // Replace the displayed image
            image.src = "https://picsum.photos/id/1025/300/200";
            image.alt = "Second Image";
        });
    </script>

</body>
</html>

6)Write a JavaScript program to demonstrate Arrow Functions for addition, 
subtraction, multiplication and division. 
<!DOCTYPE html>
<html>
<head>
    <title>Arrow Functions</title>
</head>
<body>

    <h2>Arithmetic Operations Using Arrow Functions</h2>

    <script>
        // Arrow functions
        const add = (a, b) => a + b;
        const subtract = (a, b) => a - b;
        const multiply = (a, b) => a * b;
        const divide = (a, b) => a / b;

        // Two numbers
        let num1 = 20;
        let num2 = 5;

        // Display results
        document.write("Addition: " + add(num1, num2) + "<br>");
        document.write("Subtraction: " + subtract(num1, num2) + "<br>");
        document.write("Multiplication: " + multiply(num1, num2) + "<br>");
        document.write("Division: " + divide(num1, num2) + "<br>");
    </script>

</body>
</html>

7)Write a JavaScript program using an arrow function to calculate the total 
and average marks of three subjects. Display the result using template 
literals.

<!DOCTYPE html>
<html>
<head>
    <title>Total and Average Marks</title>
</head>
<body>

    <h2>Student Marks</h2>

    <script>
        // Marks of three subjects
        let marks1 = 80;
        let marks2 = 75;
        let marks3 = 90;

        // Arrow function to calculate total and average
        const calculateMarks = (m1, m2, m3) => {
            let total = m1 + m2 + m3;
            let average = total / 3;

            return { total, average };
        };

        // Call the arrow function
        const result = calculateMarks(marks1, marks2, marks3);

        // Display result using template literals
        document.write(`
            <h3>Result</h3>
            <p>Subject 1 Marks: ${marks1}</p>
            <p>Subject 2 Marks: ${marks2}</p>
            <p>Subject 3 Marks: ${marks3}</p>
            <p>Total Marks: ${result.total}</p>
            <p>Average Marks: ${result.average}</p>
        `);
    </script>

</body>
</html>

8)Write a JavaScript program using an arrow function to calculate the total 
price of a product. Display the bill using template literals and string 
interpolation.

<!DOCTYPE html>
<html>
<head>
    <title>Product Bill</title>
</head>
<body>

    <h2>Product Bill</h2>

    <script>
        // Product details
        let productName = "Laptop";
        let price = 50000;
        let quantity = 2;

        // Arrow function to calculate total price
        const calculateTotal = (price, quantity) => price * quantity;

        // Calculate total
        let total = calculateTotal(price, quantity);

        // Display bill using template literals
        document.write(`
            <h3>----- BILL -----</h3>
            <p>Product Name: ${productName}</p>
            <p>Price: ₹${price}</p>
            <p>Quantity: ${quantity}</p>
            <p><strong>Total Price: ₹${total}</strong></p>
        `);
    </script>

</body>
</html>

9)Write a JavaScript program to swap two numbers without using a third 
variable using array destructuring.

<!DOCTYPE html>
<html>
<head>
    <title>Swap Two Numbers</title>
</head>
<body>

    <h2>Swap Two Numbers Using Array Destructuring</h2>

    <script>
        // Declare two numbers
        let a = 10;
        let b = 20;

        // Display values before swapping
        document.write(`Before Swapping: a = ${a}, b = ${b}<br>`);

        // Swap using array destructuring
        [a, b] = [b, a];

        // Display values after swapping
        document.write(`After Swapping: a = ${a}, b = ${b}`);
    </script>

</body>
</html>