1)Create a responsive webpage using CSS Flexbox for a college homepage 
containing header, navigation, content and footer. Use appropriate 
Flexbox alignment and distribution properties

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ABC College</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            background: #f4f6f8;
        }

        /* Header */
        header {
            background: #123b6d;
            color: white;
            padding: 20px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
        }

        .tagline {
            font-size: 14px;
        }

        /* Navigation */
        nav {
            background: #0d2c52;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
        }

        nav a {
            color: white;
            text-decoration: none;
            padding: 15px 22px;
            transition: background 0.3s;
        }

        nav a:hover {
            background: #1d5b9e;
        }

        /* Main Content */
        main {
            width: 90%;
            max-width: 1200px;
            margin: 30px auto;
        }

        .hero {
            background: white;
            padding: 45px;
            border-radius: 10px;
            text-align: center;
            margin-bottom: 30px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .hero h1 {
            color: #123b6d;
            margin-bottom: 10px;
            font-size: 36px;
        }

        .hero p {
            margin-bottom: 20px;
        }

        .btn {
            display: inline-block;
            background: #f39c12;
            color: white;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 5px;
        }

        /* Content Cards */
        .content {
            display: flex;
            justify-content: space-between;
            align-items: stretch;
            gap: 20px;
            flex-wrap: wrap;
        }

        .card {
            background: white;
            padding: 25px;
            flex: 1 1 250px;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .card h2 {
            color: #123b6d;
            margin-bottom: 12px;
        }

        .card ul {
            padding-left: 20px;
        }

        /* Footer */
        footer {
            background: #123b6d;
            color: white;
            padding: 30px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 40px;
        }

        .footer-section {
            flex: 1 1 200px;
        }

        .footer-section h3 {
            margin-bottom: 8px;
        }

        /* Responsive Design */
        @media (max-width: 700px) {
            header {
                justify-content: center;
                text-align: center;
            }

            nav {
                flex-direction: column;
            }

            nav a {
                width: 100%;
                text-align: center;
                padding: 12px;
            }

            .hero {
                padding: 30px 20px;
            }

            .hero h1 {
                font-size: 28px;
            }

            .content {
                flex-direction: column;
            }

            footer {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <div class="logo">ABC College</div>
        <div class="tagline">Knowledge • Excellence • Innovation</div>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="#">Home</a>
        <a href="#">About Us</a>
        <a href="#">Courses</a>
        <a href="#">Admissions</a>
        <a href="#">Campus</a>
        <a href="#">Contact</a>
    </nav>

    <!-- Main Content -->
    <main>

        <section class="hero">
            <h1>Welcome to ABC College</h1>
            <p>
                Empowering students with quality education, modern facilities,
                and opportunities for a successful future.
            </p>
            <a href="#" class="btn">Learn More</a>
        </section>

        <section class="content">

            <div class="card">
                <h2>About Us</h2>
                <p>
                    ABC College is committed to providing excellent education
                    and creating an environment that encourages learning,
                    creativity, and personal development.
                </p>
            </div>

            <div class="card">
                <h2>Our Courses</h2>
                <ul>
                    <li>Bachelor of Computer Applications</li>
                    <li>Bachelor of Commerce</li>
                    <li>Bachelor of Science</li>
                    <li>Master of Computer Applications</li>
                </ul>
            </div>

            <div class="card">
                <h2>Campus Facilities</h2>
                <ul>
                    <li>Modern Computer Labs</li>
                    <li>Digital Library</li>
                    <li>Sports Facilities</li>
                    <li>Student Activity Center</li>
                </ul>
            </div>

        </section>
    </main>

    <!-- Footer -->
    <footer>
        <div class="footer-section">
            <h3>ABC College</h3>
            <p>Building a brighter future through education.</p>
        </div>

        <div class="footer-section">
            <h3>Contact</h3>
            <p>Email: info@abccollege.edu</p>
