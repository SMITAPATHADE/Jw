        .btn {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
            transition: 0.3s;
        }

        /* Button hover effect */
        .btn:hover {
            background-color: #0056b3;
            transform: scale(1.1);
